{
  "name": "mikebillpwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && VITE_BASE=/ vite build",
    "build:pages": "tsc -b && VITE_BASE=/mikebillpwa/ vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:local": "npm run build:local && VITE_BASE=/ vite preview --host 127.0.0.1 --port 4173",
    "preview:pages": "npm run build:pages && vite preview --host 127.0.0.1 --port 4173",
    "smoke:models": "tsx src/models/__smoke.ts",
    "smoke:store": "tsx src/store/__smoke.ts"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vaul": "^1.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.65.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
